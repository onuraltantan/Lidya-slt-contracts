# Avalanche RPC endpoints
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Snowtrace verification
SNOWTRACE_API_KEY=

# Deployment private key (use a hardware wallet or KMS in production)
DEPLOYER_PRIVATE_KEY=

# Treasury Safe address (Gnosis Safe deployed via UI)
# Oracle updater (Chainlink/attester adapter key). Mainnet Deploy.s.sol REQUIRES this; the deployer hot key never holds ORACLE_UPDATER_ROLE.
ORACLE_UPDATER_ADDRESS=0x0000000000000000000000000000000000000000
TREASURY_SAFE_ADDRESS=

# Stablecoin addresses (Avalanche C-Chain)
USDC_ADDRESS=0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E
USDT_ADDRESS=0x9702230A8Ea53601f5cD2dc00fDBc13d4dF4A8c7

# Index initial value (1.0 with 18 decimals)
INDEX_INITIAL=1000000000000000000

# Mint limits (in stablecoin units, 6 decimals for USDC/USDT)
MIN_MINT_AMOUNT=1000000000      # $1,000
MAX_MINT_AMOUNT=5000000000000   # $5,000,000

# Oracle params are hardcoded in the IndexOracle constructor and not read from .env:
#   maxChangeBps = 500 (5% PER UPDATE, hard ceiling) · minUpdateInterval = 20h (floor; ceiling 1 day)
#   gracePeriod = 1 day (range 1–7 days) · gracePeriod >= minUpdateInterval + 4h enforced (M-02)
